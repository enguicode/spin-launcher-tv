<resources>
    <style name="TopButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:alpha">0.72</item>
        <item name="android:background">@drawable/top_button</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="InfoText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_300</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
